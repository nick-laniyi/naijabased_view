# ========== BLOCK ACTUAL CODE ==========
# Block all PHP files in root
/*.php
# Block all PHP files in these directories
/actions/
/ajax/
/api/
/business/
/community/
/includes/
/payments/
/phpmailer/
/professionals/
/scripts/
/webhooks/

# ========== BUT ALLOW DOCUMENTATION ==========
# Allow root documentation files
!README.md
!PROJECT_OVERVIEW.md
!INSTALL.md
!LICENSE
!CHANGELOG.md

# Allow documentation folders
!documentation/
documentation/*
!documentation/*.md

# Allow assets with diagrams
!assets/
assets/*
!assets/diagrams/
assets/diagrams/*
!assets/diagrams/*.md

# Allow database schema (structure only, no data)
!database/
database/*
!database/schema.sql
!database/README.md

# Allow screenshots folder
!screenshots/
screenshots/*
!screenshots/*.png
!screenshots/*.jpg
!screenshots/*.jpeg
!screenshots/*.gif
!screenshots/*.webp

# ========== EXPLICITLY BLOCK EVERYTHING ELSE ==========
# This ensures no stray code files get committed
/*
!/documentation/
!/assets/
!/screenshots/
!/database/
!README.md
!PROJECT_OVERVIEW.md
!INSTALL.md
!LICENSE
!CHANGELOG.md
!.gitignore